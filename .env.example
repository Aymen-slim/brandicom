# Supabase project credentials (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-never-expose-to-the-browser"

# Gemini (server only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_MODEL_CHAT="gemini-3.5-flash"
GEMINI_MODEL_FAST="gemini-3.5-flash-lite"
# Optional comma-separated fallback models tried after the primary model.
# GEMINI_MODEL_FALLBACKS="gemini-3.5-flash,gemini-3.5-flash-lite"
# Optional daily request cap per user (default 80).
# AI_DAILY_LIMIT=80

# Optional: protect GET /api/cron/health
CRON_SECRET=""

# Apify (for Instagram & TikTok engagement metrics scraping)
# Get your free token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=""
